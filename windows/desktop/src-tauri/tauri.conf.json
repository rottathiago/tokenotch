{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "Tokenotch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Tokenotch",
        "url": "index.html",
        "width": 860,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false
      },
      {
        "label": "widget",
        "title": "Tokenotch activity",
        "url": "index.html?surface=notch",
        "width": 70,
        "height": 194,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "capabilities": [
        "settings",
        "widget"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/TokenotchHook"
    ],
    "icon": [
      "binaries/Tokenotch.ico",
      "binaries/Tokenotch.png"
    ],
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../config/release.json": "WindowsRelease.json",
      "../../../config/Release.json": "Release.json",
      "../../../integrations/VSCode/TokenotchVSCode.vsix": "TokenotchVSCode.vsix"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "../../config/installer-hooks.nsh"
      }
    }
  },
  "productName": "Tokenotch",
  "version": "1.0.0",
  "identifier": "io.github.rottathiago.tokenotch"
}
